ssh_host             = "192.168.1.50"
ssh_user             = "root"
ssh_port             = 22
ssh_private_key_path = "~/.ssh/id_rsa"
deploy_path          = "/opt/citamedica"

backend_image = "ghcr.io/tu-org/citamedica-backend:latest"
landing_image = "ghcr.io/tu-org/citamedica-landing:latest"
calcom_image  = "calcom/cal.com:latest"

postgres_clinic_password = "cambia-esto"
postgres_cal_password    = "cambia-esto"
calcom_api_url           = "http://calcom:3000/api/v2"
